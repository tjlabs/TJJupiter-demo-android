<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/white">

    <!-- Test server (DEV) toggle. Save / Upload 은 이 스위치가 켜져있을 때만 활성화. -->
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchDevServer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Use Test Server (.jupiter.tjlabs.dev)"
        android:textColor="#222222" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchSaveData"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Save collected data (DEV only)"
        android:textColor="#222222" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchUploadData"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Upload telemetry (DEV only)"
        android:textColor="#222222" />

    <Button
        android:id="@+id/btnAuth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="AUTH" />

    <Button
        android:id="@+id/btnInit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="INIT" />

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="START" />

    <Button
        android:id="@+id/btnStop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="STOP" />

    <Spinner
        android:id="@+id/spinnerMockMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnMockToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="APPLY MOCK ITEM" />

    <TextView
        android:id="@+id/tvResultTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Result Log"
        android:textStyle="bold"
        android:textColor="#222222" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="#F3F3F3"
        android:fillViewport="true">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textColor="#222222"
            android:textSize="13sp"
            android:textIsSelectable="true"
            android:text="" />
    </ScrollView>

</LinearLayout>
